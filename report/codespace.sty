\ProvidesPackage{codespace}

% Package option: pass [minted] to use minted (requires --shell-escape and Pygments).
% By default, code blocks and inline code fall back to listings so the document
% compiles cleanly without --shell-escape.
\newif\ifcodespace@minted
\codespace@mintedfalse
\DeclareOption{minted}{\codespace@mintedtrue}
\ProcessOptions\relax

% Options can be used to add more predefined colors (see Section 4)
% e.g.: dvipsnames, svgnames, x11names
\RequirePackage{xcolor}

\RequirePackage{listings,lstautogobble}
\RequirePackage{verbatim}

% Configurations
\colorlet{codebackground}{magenta!10}
\definecolor{codebasic}{RGB}{106,106,106}
\definecolor{codeidentifier}{RGB}{0,0,0}
\definecolor{codecomment}{RGB}{0,136,0}
\definecolor{codestring}{RGB}{187,68,68}
\definecolor{codekeyword}{RGB}{170,34,255}

% Define plain text and LaTeX aliases, and ignore minted-specific options in listings fallback
\lstdefinelanguage{text}{}
\lstalias{latex}{TeX}
\lstalias{LaTeX}{TeX}
\define@key{lst}{highlightlines}{}

\lstdefinestyle{codeframe}{
  float=H,
  frame=lines,
  backgroundcolor=\color{codebackground},
}
\lstdefinestyle{codeblock}{
  float=,
  frame=lines,
  backgroundcolor=\color{codebackground},
}
\lstdefinestyle{altcodeblock}{
  float=,
  frame=lines,
  backgroundcolor=\color{gray!10},
}
\lstdefinestyle{codestyle}{
  basicstyle=\color{codebasic}\ttfamily,
  identifierstyle=\color{codeidentifier},
  commentstyle=\color{codecomment}\itshape,
  stringstyle=\color{codestring},
  keywordstyle=\color{codekeyword},
  numbers=left,
  %firstnumber=1,
  numbersep=2pt,
  numberstyle=\tiny,
  autogobble=true,
  breaklines=true,
  showstringspaces=false,
  tabsize=2
}
\lstset{
  style=codeframe,
  style=codestyle
}

\ifcodespace@minted
  \RequirePackage{tikz}
  \RequirePackage[framemethod=tikz]{mdframed}
  \RequirePackage{minted}

  \mdfsetup{
    leftline=false,
    rightline=false,
    backgroundcolor=codebackground,
    nobreak=false
  }
  \usemintedstyle{emacs}
  \setminted{
    linenos=true,
    numbers=left,
    %firstnumber=1,
    autogobble=true,
    breaklines=true,
    breaksymbolleft={},
    tabsize=2
  }

  \newenvironment{code}[1]{
    \VerbatimEnvironment%
    \begin{mdframed}%
      \begin{minted}{#1}%
  }{
      \end{minted}%
    \end{mdframed}%
  }

  \newenvironment{altcode}[1]{
    \VerbatimEnvironment%
    \begin{mdframed}[backgroundcolor=gray!10]%
      \begin{minted}{#1}%
  }{
      \end{minted}%
    \end{mdframed}%
  }

  \newcommand{\inputcode}[3][]{
    \begin{mdframed}%
      \inputminted[#1]{#2}{#3}%
    \end{mdframed}%
  }
\else
  \lstnewenvironment{code}[1]{%
    \lstset{style=codestyle,style=codeblock,language=#1}%
  }{}

  \lstnewenvironment{altcode}[1]{%
    \lstset{style=codestyle,style=altcodeblock,language=#1}%
  }{}

  \newcommand{\inputcode}[3][]{%
    \lstinputlisting[style=codestyle,style=codeblock,language=#2,#1]{#3}%
  }

  \newcommand{\mintinline}[3][]{%
    \begingroup\color{codebasic}\ttfamily\detokenize{#3}\endgroup%
  }
\fi
